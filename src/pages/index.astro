---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const launchpadPosts = await getCollection('launchpad');
const wealthEnginePosts = await getCollection('wealth-engine');
const bigDecisionsPosts = await getCollection('big-decisions');

// Choose 3 articles from 1st pillar, 2 from 2nd pillar, 1 from 3rd pillar
const selectedLaunchpadIds = [
  'what-is-net-worth-and-how-to-calculate-it',
  'how-lifestyle-inflation-erases-your-raises',
  'good-debt-vs-bad-debt',
];
const p1Matches = selectedLaunchpadIds
  .map((id) => launchpadPosts.find((p) => p.id === id))
  .filter(Boolean);
const p1Posts = (p1Matches.length === 3 ? p1Matches : launchpadPosts.slice(0, 3)).map((p) => ({
  ...p,
  pillar: 'launchpad',
  pillarName: 'The Launchpad',
}));

const selectedWealthEngineIds = [
  'wealth-habits-of-the-ultra-rich',
  'stock-market-101-for-beginners',
];
const p2Matches = selectedWealthEngineIds
  .map((id) => wealthEnginePosts.find((p) => p.id === id))
  .filter(Boolean);
const p2Posts = (p2Matches.length === 2 ? p2Matches : wealthEnginePosts.slice(0, 2)).map((p) => ({
  ...p,
  pillar: 'wealth-engine',
  pillarName: 'The Wealth Engine',
}));

const p3Posts = bigDecisionsPosts.slice(0, 1).map((p) => ({
  ...p,
  pillar: 'big-decisions',
  pillarName: 'The Big Decisions',
}));

const featuredPosts = [...p1Posts, ...p2Posts, ...p3Posts];
---

<Layout title="Covinair Capital | The Family Wealth Playbook">
  <section class="hero">
    <div class="hero-badge">Generational Wealth Framework</div>
    <h1 class="hero-title">The Financial Playbook They Didn't Teach You in School.</h1>
  </section>

  <section class="featured-section">
    <div class="featured-grid">
      {featuredPosts.map((post) => (
        <article class="post-card">
          <div class="card-header-meta">
            <span class="section-label">{post.pillarName}</span>
            <span class="dot">&bull;</span>
            <span class="category">{post.data.category}</span>
          </div>
          <h2>
            <a href={`/${post.pillar}/${post.id}`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 1rem 2.5rem;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border: 1px solid var(--color-primary-border);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-heading);
  }

  .featured-section {
    max-width: 960px;
    margin: 0 auto 5rem;
    padding: 0 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .post-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-primary-border);
    transform: translateY(-2px);
  }

  .card-header-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .section-label {
    color: var(--color-primary);
  }

  .dot {
    color: var(--color-text-muted);
    font-weight: normal;
  }

  .category {
    color: var(--color-text-muted);
  }

  .post-card h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0.35rem 0 0.65rem;
    line-height: 1.35;
  }

  .post-card h2 a {
    color: var(--color-text-heading);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-card h2 a:hover {
    color: var(--color-primary);
  }

  .post-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 1rem 2rem;
    }
    .hero-title {
      font-size: 1.85rem;
    }
  }
</style>
