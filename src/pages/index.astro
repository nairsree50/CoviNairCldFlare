---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const launchpadPosts = await getCollection('launchpad');
const wealthEnginePosts = await getCollection('wealth-engine');
const bigDecisionsPosts = await getCollection('big-decisions');

// Curated Top 6 Most Impactful Articles across the 3 Pillars
const topArticlesConfig = [
  { pillar: 'launchpad', id: 'a_beginner_s_roadmap_to_personal_finance', pillarName: 'The Launchpad' },
  { pillar: 'launchpad', id: 'why-savings-rate-beats-income', pillarName: 'The Launchpad' },
  { pillar: 'wealth-engine', id: 'index-funds-vs-active-mutual-funds', pillarName: 'The Wealth Engine' },
  { pillar: 'wealth-engine', id: 'global-market-volatility-guide', pillarName: 'The Wealth Engine' },
  { pillar: 'wealth-engine', id: 'the-4-percent-rule-retirement', pillarName: 'The Wealth Engine' },
  { pillar: 'big-decisions', id: 'renting-vs-buying-a-home', pillarName: 'The Big Decisions' },
];

const allPostsMap: Record<string, any[]> = {
  launchpad: launchpadPosts,
  'wealth-engine': wealthEnginePosts,
  'big-decisions': bigDecisionsPosts,
};

const featuredPosts = topArticlesConfig
  .map((cfg) => {
    const post = allPostsMap[cfg.pillar]?.find((p) => p.id === cfg.id);
    if (!post) return null;
    return {
      ...post,
      pillar: cfg.pillar,
      pillarName: cfg.pillarName,
    };
  })
  .filter(Boolean);
---

<Layout title="Covinair Capital | The Family Wealth Playbook">
  <section class="hero">
    <div class="hero-badge">Generational Wealth Framework</div>
    <h1 class="hero-title">The Financial Playbook They Didn't Teach You in School.</h1>
  </section>

  <section class="featured-section">
    <div class="featured-grid">
      {featuredPosts.map((post) => (
        <article class="post-card">
          {post.data.heroImage && (
            <a href={`/${post.pillar}/${post.id}`} class="card-image-link" tabindex="-1" aria-hidden="true">
              <img src={post.data.heroImage} alt={post.data.title} class="card-image" loading="lazy" />
            </a>
          )}
          <div class="card-body">
            <div class="card-header-meta">
              <span class="section-label">{post.pillarName}</span>
              <span class="dot">&bull;</span>
              <span class="category">{post.data.category}</span>
            </div>
            <h2>
              <a href={`/${post.pillar}/${post.id}`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 1rem 2.5rem;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border: 1px solid var(--color-primary-border);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-heading);
  }

  .featured-section {
    max-width: 960px;
    margin: 0 auto 5rem;
    padding: 0 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .post-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-primary-border);
    transform: translateY(-2px);
  }

  .card-image-link {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-hover);
    border-bottom: 1px solid var(--color-border);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.02);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-header-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .section-label {
    color: var(--color-primary);
  }

  .dot {
    color: var(--color-text-muted);
    font-weight: normal;
  }

  .category {
    color: var(--color-text-muted);
  }

  .post-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0.35rem 0 0.65rem;
    line-height: 1.35;
  }

  .post-card h2 a {
    color: var(--color-text-heading);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-card h2 a:hover {
    color: var(--color-primary);
  }

  .post-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 1rem 2rem;
    }
    .hero-title {
      font-size: 1.85rem;
    }
  }
</style>
