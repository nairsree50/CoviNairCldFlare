---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('wealth-engine')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="The Wealth Engine | Covinair Capital">
  <div class="posts-list">
    {posts.map((post, index) => (
      <article class={`post-card ${index >= 4 ? 'hidden-card' : ''}`}>
        <span class="category">{post.data.category}</span>
        <h2>
          <a href={`/wealth-engine/${post.id}`}>{post.data.title}</a>
        </h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </div>

  {posts.length > 4 && (
    <div class="load-more-wrap">
      <button id="load-more-btn" class="btn-load-more">Load More Articles</button>
    </div>
  )}

  <script is:inline>
    const loadMoreBtn = document.getElementById('load-more-btn');
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        document.querySelectorAll('.post-card.hidden-card').forEach((card) => {
          card.classList.remove('hidden-card');
        });
        loadMoreBtn.parentElement.remove();
      });
    }
  </script>
</Layout>

<style>
  .posts-list {
    display: grid;
    gap: 1.5rem;
    max-width: 800px;
    margin: 2.5rem auto 1.5rem;
  }

  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .post-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-primary-border);
    transform: translateY(-1px);
  }

  .post-card.hidden-card {
    display: none;
  }

  .category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-card h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0.5rem 0 0.65rem;
    line-height: 1.35;
  }

  .post-card h2 a {
    color: var(--color-text-heading);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-card h2 a:hover {
    color: var(--color-primary);
  }

  .post-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .load-more-wrap {
    text-align: center;
    margin: 2rem auto 4rem;
  }

  .btn-load-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }

  .btn-load-more:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
  }
</style>
