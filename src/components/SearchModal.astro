---
// SearchModal.astro - Minimalist search showing matched topics across main site
---

<div id="search-modal-container">
  <!-- Minimalist Search Trigger Icon Button (No text strings or Ctrl K) -->
  <button id="search-trigger-btn" type="button" class="search-trigger-btn" aria-label="Search">
    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </button>

  <!-- Backdrop & Dialog -->
  <div id="search-dialog-backdrop" class="search-backdrop hidden" aria-hidden="true">
    <div class="search-dialog" role="dialog" aria-modal="true">
      <!-- Input bar with NO default placeholder text -->
      <div class="search-header">
        <svg class="search-icon active-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          id="search-input" 
          type="search" 
          autocomplete="off" 
          spellcheck="false" 
          aria-label="Search"
        />
        <button id="search-close-btn" type="button" class="search-close" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Results List showing topics only -->
      <div id="search-results-wrapper" class="search-results-wrapper">
        <div id="search-status" class="search-status"></div>
        <ul id="search-results-list" class="search-results-list" role="listbox"></ul>
      </div>
    </div>
  </div>
</div>

<script>
  import MiniSearch from 'minisearch';

  interface SearchItem {
    id: string;
    title: string;
    description: string;
    category: string;
    section: string;
    url: string;
    tags: string[];
    content: string;
  }

  let searchIndex: MiniSearch<SearchItem> | null = null;
  let rawItems: SearchItem[] = [];
  let isFetching = false;
  let selectedIndex = -1;

  const triggerBtn = document.getElementById('search-trigger-btn');
  const backdrop = document.getElementById('search-dialog-backdrop');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('search-close-btn');
  const resultsList = document.getElementById('search-results-list');
  const statusMsg = document.getElementById('search-status');

  async function loadSearchIndex() {
    if (searchIndex || isFetching) return;
    isFetching = true;
    try {
      const res = await fetch('/search.json');
      if (!res.ok) throw new Error('Failed to fetch search data');
      rawItems = await res.json();

      searchIndex = new MiniSearch({
        fields: ['title', 'description', 'category', 'section', 'content'],
        storeFields: ['id', 'title', 'category', 'section', 'url'],
        searchOptions: {
          boost: { title: 4, category: 2, description: 1.5, content: 1 },
          prefix: true,
          fuzzy: 0.2,
        },
      });

      searchIndex.addAll(rawItems);
    } catch (err) {
      console.error('Search index initialization error:', err);
    } finally {
      isFetching = false;
    }
  }

  function openSearch() {
    if (!backdrop || !searchInput) return;
    backdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    loadSearchIndex();
    setTimeout(() => {
      searchInput.focus();
      if (searchInput.value.trim().length > 0) {
        performSearch(searchInput.value.trim());
      }
    }, 50);
  }

  function closeSearch() {
    if (!backdrop || !searchInput) return;
    backdrop.classList.add('hidden');
    document.body.style.overflow = '';
    searchInput.value = '';
    if (resultsList) resultsList.innerHTML = '';
    if (statusMsg) {
      statusMsg.textContent = '';
      statusMsg.style.display = 'none';
    }
    selectedIndex = -1;
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function highlightMatches(text: string, query: string): string {
    if (!text) return '';
    let safeText = escapeHtml(text);
    const tokens = query.toLowerCase().split(/\s+/).filter(t => t.length > 1);
    for (const token of tokens) {
      const regex = new RegExp(`(${token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      safeText = safeText.replace(regex, '<mark>$1</mark>');
    }
    return safeText;
  }

  function performSearch(query: string) {
    if (!resultsList || !statusMsg) return;

    if (!query) {
      resultsList.innerHTML = '';
      statusMsg.textContent = '';
      statusMsg.style.display = 'none';
      selectedIndex = -1;
      return;
    }

    if (!searchIndex) {
      statusMsg.style.display = 'block';
      statusMsg.textContent = 'Loading...';
      return;
    }

    const results = searchIndex.search(query);

    if (results.length === 0) {
      resultsList.innerHTML = '';
      statusMsg.style.display = 'block';
      statusMsg.textContent = 'No matching topics found';
      selectedIndex = -1;
      return;
    }

    statusMsg.style.display = 'none';

    // Show up to 15 matching topics
    const displayed = results.slice(0, 15);
    selectedIndex = 0;

    resultsList.innerHTML = displayed.map((res, index) => {
      const item = res as unknown as SearchItem;
      const titleHighlighted = highlightMatches(item.title, query);
      const sectionBadge = item.section || item.category || 'Article';

      return `
        <li class="search-result-item ${index === 0 ? 'selected' : ''}" role="option" data-url="${item.url}" data-index="${index}">
          <a href="${item.url}" class="result-link">
            <span class="result-badge">${escapeHtml(sectionBadge)}</span>
            <span class="result-title">${titleHighlighted}</span>
          </a>
        </li>
      `;
    }).join('');

    const items = resultsList.querySelectorAll('.search-result-item');
    items.forEach((itemEl) => {
      itemEl.addEventListener('mouseenter', () => {
        const idx = Number(itemEl.getAttribute('data-index'));
        updateSelection(idx);
      });
    });
  }

  function updateSelection(newIndex: number) {
    if (!resultsList) return;
    const items = resultsList.querySelectorAll('.search-result-item');
    if (items.length === 0) return;

    if (newIndex < 0) newIndex = 0;
    if (newIndex >= items.length) newIndex = items.length - 1;

    items.forEach((el, idx) => {
      if (idx === newIndex) {
        el.classList.add('selected');
        el.scrollIntoView({ block: 'nearest' });
      } else {
        el.classList.remove('selected');
      }
    });

    selectedIndex = newIndex;
  }

  function navigateToSelected() {
    if (!resultsList) return;
    const items = resultsList.querySelectorAll('.search-result-item');
    if (selectedIndex >= 0 && selectedIndex < items.length) {
      const url = items[selectedIndex].getAttribute('data-url');
      if (url) {
        window.location.href = url;
      }
    }
  }

  // Event Listeners
  if (triggerBtn) {
    triggerBtn.addEventListener('click', openSearch);
    triggerBtn.addEventListener('mouseenter', loadSearchIndex);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeSearch);
  }

  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeSearch();
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.trim();
      performSearch(val);
    });
  }

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (backdrop && !backdrop.classList.contains('hidden')) {
        closeSearch();
      } else {
        openSearch();
      }
      return;
    }

    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      if (backdrop && backdrop.classList.contains('hidden')) {
        e.preventDefault();
        openSearch();
        return;
      }
    }

    if (backdrop && !backdrop.classList.contains('hidden')) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeSearch();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateSelection(selectedIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateSelection(selectedIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        navigateToSelected();
      }
    }
  });
</script>

<style>
  /* Minimalist Search Trigger Button */
  .search-trigger-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-trigger-btn:hover {
    background: var(--color-surface-hover);
    border-color: #cbd5e1;
    color: var(--color-text-heading);
  }

  .search-icon {
    flex-shrink: 0;
  }

  /* Modal Backdrop */
  .search-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5rem 1rem 1rem 1rem;
    transition: opacity 0.15s ease;
  }

  .search-backdrop.hidden {
    display: none;
    opacity: 0;
    pointer-events: none;
  }

  /* Dialog Container */
  .search-dialog {
    width: 100%;
    max-width: 580px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 75vh;
    animation: searchPopIn 0.12s ease-out;
  }

  @keyframes searchPopIn {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Header Input Bar */
  .search-header {
    display: flex;
    align-items: center;
    padding: 0.85rem 1.15rem;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    background: #ffffff;
  }

  .active-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.05rem;
    color: var(--color-text-heading);
    background: transparent;
    font-family: inherit;
  }

  #search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s;
  }

  .search-close:hover {
    color: var(--color-text-heading);
  }

  /* Results List */
  .search-results-wrapper {
    overflow-y: auto;
    max-height: 55vh;
    padding: 0.35rem 0;
  }

  .search-status {
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    display: none;
  }

  .search-results-list {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .search-result-item {
    border-radius: 6px;
    transition: background 0.12s ease;
  }

  .search-result-item.selected,
  .search-result-item:hover {
    background: var(--color-primary-soft);
  }

  .result-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .result-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: #f1f5f9;
    color: #475569;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .search-result-item.selected .result-badge {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .result-title {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--color-text-heading);
    line-height: 1.35;
  }

  :global(.search-result-item mark) {
    background: #fef08a;
    color: #854d0e;
    padding: 0 0.15rem;
    border-radius: 2px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .search-backdrop {
      padding: 1rem 0.75rem;
    }
  }
</style>
