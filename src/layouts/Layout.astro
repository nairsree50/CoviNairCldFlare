---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Covinair Capital | The Family Wealth Playbook", 
  description = "A generational guide to mastering daily cash flow, and long-term wealth—building for every stage of your life." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --color-bg: #ffffff;
        --color-surface: #f9fafb;
        --color-surface-hover: #f3f4f6;
        --color-border: #e5e7eb;
        --color-text: #1f2937;
        --color-text-heading: #111827;
        --color-text-muted: #6b7280;
        --color-primary: #2563eb;
        --color-primary-hover: #1d4ed8;
        --color-primary-soft: #eff6ff;
        --color-primary-border: #bfdbfe;
        --color-link: #2563eb;
        --color-accent: #059669;
        --nav-bg: rgba(255, 255, 255, 0.9);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1, h2, h3, h4, h5, h6 {
        color: var(--color-text-heading);
      }
    </style>
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand">
          Covinair Capital <span class="brand-sub">| The Family Wealth Playbook</span>
        </a>

        <nav class="nav-links">
          <a href="/launchpad" class="nav-link">The Launchpad</a>
          <a href="/wealth-engine" class="nav-link">The Wealth Engine</a>
          <a href="/big-decisions" class="nav-link">The Big Decisions</a>
        </nav>
      </div>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <p>&copy; {new Date().getFullYear()} Covinair Capital. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-heading);
    white-space: nowrap;
  }

  .brand-sub {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--color-text-muted);
    font-size: 0.925rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-text-heading);
  }

  .content {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .nav-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      flex-wrap: wrap;
      gap: 1rem;
      width: 100%;
    }

    .btn-start {
      margin-left: auto;
    }
  }
</style>
